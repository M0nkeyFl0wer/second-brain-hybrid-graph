[Unit]
Description=open-second-brain health check every 15 minutes
After=network-online.target

# __INSTALL_DIR__ is a placeholder — replace with your checkout path,
# or run `bash setup.sh --install-timers` to substitute it automatically.

[Service]
Type=oneshot
Environment=PYTHONPATH=__INSTALL_DIR__
ExecStart=__INSTALL_DIR__/scripts/health_check.py
StandardOutput=journal
StandardError=journal

# Exit codes: 0=healthy, 1=warning, 2=critical
SuccessExitStatus=0 1

[Install]
WantedBy=timers.target